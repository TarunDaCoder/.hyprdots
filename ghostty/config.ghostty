# font-family = CartoGraphCF Nerd Font Mono
# font-family = JetBrainsMono Nerd Font
font-family = SauceCodePro Nerd Font

font-codepoint-map = U+ea60-U+ebeb,U+e0ca,U+e0cc-U+e0d4,U+e200-U+e2a9,U+e300-U+e3e3,U+e5fa-U+e6b1,U+e700-U+e7c5,U+f000-U+f2e0,U+f300-U+f372,U+f400-U+f532,U+f0001-U+f1af0 = Symbols Nerd Font Mono
font-codepoint-map = U+e900 = icomoon

font-size = 10
adjust-cell-height = 40%

# background = "#24273a"

# custom-shader = ./gradient.glsl
# custom-shader = ~/.config/ghostty/retro.glsl
custom-shader = ~/.config/ghostty/blaze.glsl

theme = Catppuccin Macchiato

shell-integration = zsh

background-opacity = 0.8
# background-blur = true

title = "Ghostty 󰊠 "

window-theme = "ghostty"

window-padding-x = 10,10
window-padding-y = 10,10
